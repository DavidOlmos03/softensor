# Production Environment Variables
NODE_ENV=production

# Application
APP_NAME=Softensor
APP_URL=https://softensor.com

# Next.js
PORT=3000
HOSTNAME=0.0.0.0

# Nginx
NGINX_PORT=80

# i18n
DEFAULT_LOCALE=es
AVAILABLE_LOCALES=es,en

# Production Settings
NEXT_TELEMETRY_DISABLED=1

# IMPORTANT: Replace these with your production values
# Contact Form (configure when implementing)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=

# Analytics (configure if needed)
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_GTM_ID=

# Security (generate secure keys)
# SESSION_SECRET=
# API_KEY=
